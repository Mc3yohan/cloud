{
  "$schema": "https://json-schema.org/draft/07/schema#",
  "$id": "https://hanzo.ai/schemas/cloud-30-tau2-dual-control-results.json",
  "title": "cloud#30 Dual-Control Business-Agent Benchmark (tau2-bench) Results Schema",
  "description": "Machine-readable schema for the 36-cell dual-control benchmark matrix and concurrent goroutine race verification in research/tau2dualcontrol (HIP-1348 / HIP-1347 §2.9).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark",
    "issue",
    "tracking_hip",
    "related_hip",
    "episodes_per_cell",
    "seeds",
    "cells",
    "aggregated_by_mode",
    "concurrent_race_check"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "hanzo.tau2dualcontrol.results/v1"
    },
    "benchmark": {
      "type": "string",
      "minLength": 1
    },
    "issue": {
      "type": "string",
      "format": "uri"
    },
    "tracking_hip": {
      "type": "string",
      "pattern": "^HIP-[0-9]+"
    },
    "related_hip": {
      "type": "string",
      "minLength": 1
    },
    "episodes_per_cell": {
      "type": "integer",
      "minimum": 1
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/cell_metrics"
      }
    },
    "aggregated_by_mode": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/mode_summary"
      }
    },
    "concurrent_race_check": {
      "$ref": "#/definitions/concurrent_race_summary"
    }
  },
  "definitions": {
    "cell_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regime",
        "mode",
        "seed",
        "episodes",
        "episode_successes",
        "goal_achieved_count",
        "safety_violation_count",
        "ledger_violation_count",
        "permission_violation_count",
        "lost_update_count",
        "double_refund_count",
        "duplicate_side_effect_count",
        "unauthorized_write_count",
        "replay_verified_count",
        "safe_lease_handoff_count",
        "task_success_rate",
        "safety_violation_rate",
        "replay_verified_rate",
        "safe_handoff_rate",
        "total_store_calls",
        "mean_store_calls_per_ep",
        "p95_store_calls_per_ep",
        "total_cas_retries",
        "total_lease_retries",
        "total_precondition_retries",
        "total_idempotent_saves",
        "total_timeout_faults",
        "per_family_success_rate"
      ],
      "properties": {
        "regime": {
          "type": "string",
          "enum": ["low_interleaving", "medium_interleaving", "high_contention_faults"]
        },
        "mode": {
          "type": "string",
          "enum": ["single_control", "dual_uncoordinated", "dual_rbac_lww", "dual_cas_lease"]
        },
        "seed": { "type": "integer", "minimum": 0 },
        "episodes": { "type": "integer", "minimum": 1 },
        "episode_successes": { "type": "integer", "minimum": 0 },
        "goal_achieved_count": { "type": "integer", "minimum": 0 },
        "safety_violation_count": { "type": "integer", "minimum": 0 },
        "ledger_violation_count": { "type": "integer", "minimum": 0 },
        "permission_violation_count": { "type": "integer", "minimum": 0 },
        "lost_update_count": { "type": "integer", "minimum": 0 },
        "double_refund_count": { "type": "integer", "minimum": 0 },
        "duplicate_side_effect_count": { "type": "integer", "minimum": 0 },
        "unauthorized_write_count": { "type": "integer", "minimum": 0 },
        "replay_verified_count": { "type": "integer", "minimum": 0 },
        "safe_lease_handoff_count": { "type": "integer", "minimum": 0 },
        "task_success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "safety_violation_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "replay_verified_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "safe_handoff_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "total_store_calls": { "type": "integer", "minimum": 0 },
        "mean_store_calls_per_ep": { "type": "number", "minimum": 0 },
        "p95_store_calls_per_ep": { "type": "integer", "minimum": 0 },
        "total_cas_retries": { "type": "integer", "minimum": 0 },
        "total_lease_retries": { "type": "integer", "minimum": 0 },
        "total_precondition_retries": { "type": "integer", "minimum": 0 },
        "total_idempotent_saves": { "type": "integer", "minimum": 0 },
        "total_timeout_faults": { "type": "integer", "minimum": 0 },
        "per_family_success_rate": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "mode_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "total_episodes",
        "task_success_rate",
        "safety_violation_rate",
        "ledger_violation_count",
        "permission_violation_count",
        "lost_update_count",
        "double_refund_count",
        "duplicate_side_effect_count",
        "replay_verified_rate",
        "safe_handoff_count",
        "mean_store_calls_per_ep"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["single_control", "dual_uncoordinated", "dual_rbac_lww", "dual_cas_lease"]
        },
        "total_episodes": { "type": "integer", "minimum": 1 },
        "task_success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "safety_violation_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "ledger_violation_count": { "type": "integer", "minimum": 0 },
        "permission_violation_count": { "type": "integer", "minimum": 0 },
        "lost_update_count": { "type": "integer", "minimum": 0 },
        "double_refund_count": { "type": "integer", "minimum": 0 },
        "duplicate_side_effect_count": { "type": "integer", "minimum": 0 },
        "replay_verified_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "safe_handoff_count": { "type": "integer", "minimum": 0 },
        "mean_store_calls_per_ep": { "type": "number", "minimum": 0 }
      }
    },
    "concurrent_race_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trials_per_mode",
        "lww_double_refund_violations",
        "cas_lease_double_refund_violations",
        "cas_lease_replay_verified"
      ],
      "properties": {
        "trials_per_mode": { "type": "integer", "minimum": 1 },
        "lww_double_refund_violations": { "type": "integer", "minimum": 0 },
        "cas_lease_double_refund_violations": { "type": "integer", "minimum": 0 },
        "cas_lease_replay_verified": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
